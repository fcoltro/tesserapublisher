<?xml version="1.0" encoding="windows-1252"?>
<!--
  The Windows installer, for cargo-wix.

  Two things beyond copying a binary in: the profiles travel beside it, and
  .tsrdf is associated with it. Both are the difference between an
  application that runs and one somebody can use.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="Tessera Publisher"
           UpgradeCode="6F3A0C2E-7B41-4E2D-9C88-1B5A4E77D310"
           Manufacturer="Tessera"
           Language="1033"
           Codepage="1252"
           Version="$(var.Version)">

    <Package Id="*"
             Keywords="Installer"
             Description="Tessera Publisher"
             Manufacturer="Tessera"
             InstallerVersion="450"
             Languages="1033"
             Compressed="yes"
             InstallScope="perMachine"
             SummaryCodepage="1252"/>

    <!-- Upgrades replace rather than accumulate. Without this every version
         installs beside the last one and the Start menu fills with them. -->
    <MajorUpgrade Schedule="afterInstallInitialize"
                  DowngradeErrorMessage="A newer version of Tessera Publisher is already installed."/>

    <Media Id="1" Cabinet="media1.cab" EmbedCab="yes"/>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="APPLICATIONFOLDER" Name="Tessera Publisher">
          <Component Id="Binary" Guid="*">
            <File Id="exe"
                  Name="tessera-publisher.exe"
                  Source="$(var.CargoTargetBinDir)\tessera_app.exe"
                  KeyPath="yes"/>

            <!-- The association, and it is a sibling of the file rather than a
                 child of it: WiX allows `ProgId` under a Component, a Class or
                 an Advertise, and not under a `File`.

                 `ProgId` gives the extension a name, the extension gives the
                 name a verb, and the verb is what runs when a document is
                 double-clicked. All three are needed; two of them produce an
                 extension Windows knows about and will not open. `TargetFile`
                 says which binary, which an advertised verb would have taken
                 from its component and a plain one has to be told. -->
            <ProgId Id="Tessera.Document" Description="Tessera document">
              <Extension Id="tsrdf" ContentType="application/x-tessera-document">
                <Verb Id="open"
                      Command="Open"
                      TargetFile="exe"
                      Argument="&quot;%1&quot;"/>
              </Extension>
            </ProgId>

            <!-- The document icon, which the ProgId above does not give it.
                 It is the executable's second icon resource, embedded by
                 `build.rs`; a negative number after the comma names a
                 resource by its ID rather than by its position, so it does
                 not move if another icon is ever added ahead of it. Written
                 as a registry value rather than through `ProgId/@Icon`,
                 because that route copies the whole executable into the
                 installer's icon table to get one icon out of it. -->
            <RegistryValue Root="HKCR"
                           Key="Tessera.Document\DefaultIcon"
                           Type="string"
                           Value="&quot;[#exe]&quot;,-2"/>
          </Component>

          <!-- The colour profiles, in the directory `bundled_directory` looks
               in first. An install without them starts and quietly cannot
               soft-proof or export PDF/X.

               **One component per file, and every file named.** WiX will not
               generate a GUID for a component holding several files unless its
               keypath is a versioned one, and an ICC profile has no version
               resource. And there is no way to say "this directory" at all, so
               a list is the only option — a list carrying some of the presses
               would be worse than none, because the ones missing are missing
               silently. `the_installer_carries_every_profile` holds this list
               against the repository.

               Sourced from `$(var.CargoTargetBinDir)`, which cargo-wix defines
               as an absolute path: `packaging/build.sh` stages the profiles
               beside the binary before calling it, so candle does not have to
               guess what a relative path is relative to. -->
          <Directory Id="ProfilesFolder" Name="profiles">
            <Component Id="Profile0" Guid="*">
              <File Id="Profile0File"
                    Name="manifest.tsv"
                    Source="$(var.CargoTargetBinDir)\profiles\manifest.tsv"
                    KeyPath="yes"/>
            </Component>
            <Component Id="Profile1" Guid="*">
              <File Id="Profile1File"
                    Name="CGATS21_CRPC1.icc"
                    Source="$(var.CargoTargetBinDir)\profiles\CGATS21_CRPC1.icc"
                    KeyPath="yes"/>
            </Component>
            <Component Id="Profile2" Guid="*">
              <File Id="Profile2File"
                    Name="CGATS21_CRPC2.icc"
                    Source="$(var.CargoTargetBinDir)\profiles\CGATS21_CRPC2.icc"
                    KeyPath="yes"/>
            </Component>
            <Component Id="Profile3" Guid="*">
              <File Id="Profile3File"
                    Name="CGATS21_CRPC3.icc"
                    Source="$(var.CargoTargetBinDir)\profiles\CGATS21_CRPC3.icc"
                    KeyPath="yes"/>
            </Component>
            <Component Id="Profile4" Guid="*">
              <File Id="Profile4File"
                    Name="CGATS21_CRPC4.icc"
                    Source="$(var.CargoTargetBinDir)\profiles\CGATS21_CRPC4.icc"
                    KeyPath="yes"/>
            </Component>
            <Component Id="Profile5" Guid="*">
              <File Id="Profile5File"
                    Name="CGATS21_CRPC5.icc"
                    Source="$(var.CargoTargetBinDir)\profiles\CGATS21_CRPC5.icc"
                    KeyPath="yes"/>
            </Component>
            <Component Id="Profile6" Guid="*">
              <File Id="Profile6File"
                    Name="CGATS21_CRPC6.icc"
                    Source="$(var.CargoTargetBinDir)\profiles\CGATS21_CRPC6.icc"
                    KeyPath="yes"/>
            </Component>
            <Component Id="Profile7" Guid="*">
              <File Id="Profile7File"
                    Name="CGATS21_CRPC7.icc"
                    Source="$(var.CargoTargetBinDir)\profiles\CGATS21_CRPC7.icc"
                    KeyPath="yes"/>
            </Component>
            <Component Id="Profile8" Guid="*">
              <File Id="Profile8File"
                    Name="sRGB2014.icc"
                    Source="$(var.CargoTargetBinDir)\profiles\sRGB2014.icc"
                    KeyPath="yes"/>
            </Component>
            <Component Id="Profile9" Guid="*">
              <File Id="Profile9File"
                    Name="sRGB_v4_ICC_preference.icc"
                    Source="$(var.CargoTargetBinDir)\profiles\sRGB_v4_ICC_preference.icc"
                    KeyPath="yes"/>
            </Component>
          </Directory>
          <!-- Ghostscript, run as a program of its own to place EPS artwork.
               The Windows build carries its resources compiled into the DLL,
               so the console program and the DLL are all it needs; its
               licence and where its source is travel with it.
               **A file to a component**, as the profiles are: WiX will not
               generate the GUID of a component holding several files unless
               a versioned one is its key, and refuses the whole build. -->
          <Directory Id="GhostscriptFolder" Name="ghostscript">
            <Component Id="GhostscriptReadme" Guid="*">
              <File Id="GhostscriptReadmeFile" Name="README.txt"
                    Source="$(var.CargoTargetBinDir)\ghostscript\README.txt"
                    KeyPath="yes"/>
            </Component>
            <Component Id="GhostscriptLicence" Guid="*">
              <File Id="GhostscriptLicenceFile" Name="LICENSE"
                    Source="$(var.CargoTargetBinDir)\ghostscript\LICENSE"
                    KeyPath="yes"/>
            </Component>
            <Component Id="GhostscriptCopying" Guid="*">
              <File Id="GhostscriptCopyingFile" Name="COPYING"
                    Source="$(var.CargoTargetBinDir)\ghostscript\COPYING"
                    KeyPath="yes"/>
            </Component>
            <Directory Id="GhostscriptBin" Name="bin">
              <Component Id="GhostscriptExe" Guid="*">
                <File Id="GhostscriptExeFile" Name="gswin64c.exe"
                      Source="$(var.CargoTargetBinDir)\ghostscript\bin\gswin64c.exe"
                      KeyPath="yes"/>
              </Component>
              <Component Id="GhostscriptDll" Guid="*">
                <File Id="GhostscriptDllFile" Name="gsdll64.dll"
                      Source="$(var.CargoTargetBinDir)\ghostscript\bin\gsdll64.dll"
                      KeyPath="yes"/>
              </Component>
            </Directory>
          </Directory>
          <!-- The spelling dictionaries, SCOWL's American and British
               English, and the README holding their licence. A file to a
               component, as above. -->
          <Directory Id="DictionariesFolder" Name="dictionaries">
            <Component Id="DictUsDic" Guid="*">
              <File Id="DictUsDicFile" Name="en_US.dic"
                    Source="$(var.CargoTargetBinDir)\dictionaries\en_US.dic"
                    KeyPath="yes"/>
            </Component>
            <Component Id="DictUsAff" Guid="*">
              <File Id="DictUsAffFile" Name="en_US.aff"
                    Source="$(var.CargoTargetBinDir)\dictionaries\en_US.aff"
                    KeyPath="yes"/>
            </Component>
            <Component Id="DictGbDic" Guid="*">
              <File Id="DictGbDicFile" Name="en_GB.dic"
                    Source="$(var.CargoTargetBinDir)\dictionaries\en_GB.dic"
                    KeyPath="yes"/>
            </Component>
            <Component Id="DictGbAff" Guid="*">
              <File Id="DictGbAffFile" Name="en_GB.aff"
                    Source="$(var.CargoTargetBinDir)\dictionaries\en_GB.aff"
                    KeyPath="yes"/>
            </Component>
            <Component Id="DictReadme" Guid="*">
              <File Id="DictReadmeFile" Name="README.txt"
                    Source="$(var.CargoTargetBinDir)\dictionaries\README.txt"
                    KeyPath="yes"/>
            </Component>
            <Component Id="DictUsReadme" Guid="*">
              <File Id="DictUsReadmeFile" Name="README_en_US.txt"
                    Source="$(var.CargoTargetBinDir)\dictionaries\README_en_US.txt"
                    KeyPath="yes"/>
            </Component>
            <Component Id="DictGbReadme" Guid="*">
              <File Id="DictGbReadmeFile" Name="README_en_GB-ise.txt"
                    Source="$(var.CargoTargetBinDir)\dictionaries\README_en_GB-ise.txt"
                    KeyPath="yes"/>
            </Component>
          </Directory>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <!-- **A component of its own, keyed on the registry.** A non-advertised
             shortcut in a per-machine component fails ICE43 and ICE57: the
             shortcut is per-user data and the file it points at is per-machine,
             so the component would have two owners and no honest keypath. An
             HKCU value is the keypath Windows expects here, and it is what
             tells the installer whether *this* user has the shortcut. -->
        <Component Id="StartMenuShortcut" Guid="*">
          <Shortcut Id="StartMenu"
                    Name="Tessera Publisher"
                    Description="Lay out pages for print and screen"
                    Target="[APPLICATIONFOLDER]tessera-publisher.exe"
                    WorkingDirectory="APPLICATIONFOLDER"/>
          <RemoveFolder Id="RemoveProgramMenuFolder" On="uninstall"/>
          <RegistryValue Root="HKCU"
                         Key="Software\Tessera\Publisher"
                         Name="installed"
                         Type="integer"
                         Value="1"
                         KeyPath="yes"/>
        </Component>
      </Directory>
    </Directory>

    <Feature Id="Complete" Level="1" Title="Tessera Publisher" Display="expand"
             ConfigurableDirectory="APPLICATIONFOLDER" AllowAdvertise="no" Absent="disallow">
      <ComponentRef Id="Binary"/>
      <ComponentRef Id="StartMenuShortcut"/>
      <ComponentRef Id="Profile0"/>
      <ComponentRef Id="Profile1"/>
      <ComponentRef Id="Profile2"/>
      <ComponentRef Id="Profile3"/>
      <ComponentRef Id="Profile4"/>
      <ComponentRef Id="Profile5"/>
      <ComponentRef Id="Profile6"/>
      <ComponentRef Id="Profile7"/>
      <ComponentRef Id="Profile8"/>
      <ComponentRef Id="Profile9"/>
      <ComponentRef Id="GhostscriptReadme"/>
      <ComponentRef Id="GhostscriptLicence"/>
      <ComponentRef Id="GhostscriptCopying"/>
      <ComponentRef Id="GhostscriptExe"/>
      <ComponentRef Id="GhostscriptDll"/>
      <ComponentRef Id="DictUsDic"/>
      <ComponentRef Id="DictUsAff"/>
      <ComponentRef Id="DictGbDic"/>
      <ComponentRef Id="DictGbAff"/>
      <ComponentRef Id="DictReadme"/>
      <ComponentRef Id="DictUsReadme"/>
      <ComponentRef Id="DictGbReadme"/>
    </Feature>

    <Icon Id="ProductIcon" SourceFile="$(var.CargoTargetBinDir)\tessera_app.exe"/>
    <Property Id="ARPPRODUCTICON" Value="ProductIcon"/>
    <Property Id="ARPNOREPAIR" Value="yes" Secure="yes"/>
  </Product>
</Wix>
